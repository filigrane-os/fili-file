    },
    {
      "name": "up",
      "label": "Enclosing Folder",
      "keys": "Alt+Up"
    },
    {
      "name": "move-favorite-up",
      "label": "Move Favorite Up",
      "keys": "Alt+Shift+Up"
    },
    {
      "name": "move-favorite-down",
