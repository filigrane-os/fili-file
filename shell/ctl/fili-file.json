    },
    {
      "name": "select-same-kind",
      "label": "Select Same Kind"
    },
    {
      "name": "terminal",
      "label": "Open Terminal Here",
      "keys": "Ctrl+Alt+T"
    },
    {
      "name": "view-list",
      "label": "View as List",
      "keys": "Ctrl+1"
    },
    {
      "name": "view-icons",
      "label": "View as Icons",
      "keys": "Ctrl+2"
    },
    {
      "name": "toggle-hidden",
      "label": "Show Hidden Files",
      "keys": "Ctrl+H"
    },
    {
      "name": "toggle-preview",
      "label": "Show Preview",
      "keys": "Ctrl+Shift+P"
    },
    {
      "name": "toggle-header",
      "label": "Show Header"
    },
    {
      "name": "toggle-footer",
      "label": "Show Status Bar"
    },
    {
      "name": "debug",
      "label": "Debug Logs",
      "keys": "Ctrl+Shift+L"
    },
    {
      "name": "toggle-window-buttons",
      "label": "Show Window Buttons"
    },
    {
      "name": "window-actions",
      "label": "Window Actions…",
      "keys": "Ctrl+Shift+W"
    },
    {
      "name": "copy-path",
