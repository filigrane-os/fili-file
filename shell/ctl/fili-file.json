      "keys": "Ctrl+Tab"
    },
    {
      "name": "prev-tab",
      "label": "Show Previous Tab",
      "keys": "Ctrl+Shift+Tab"
    },
    {
      "name": "about",
      "label": "About Casier"
    },
    {
      "name": "undo",
      "label": "Undo",
      "keys": "Ctrl+Z"
    },
    {
      "name": "cut",
      "label": "Cut",
      "keys": "Ctrl+X"
    },
    {
      "name": "copy",
      "label": "Copy",
      "keys": "Ctrl+C"
    },
    {
      "name": "paste",
      "label": "Paste",
      "keys": "Ctrl+V"
    },
    {
      "name": "duplicate",
      "label": "Duplicate",
      "keys": "Ctrl+D"
    },
    {
      "name": "compress",
      "label": "Compress…",
