      "keys": "Ctrl+A"
    },
    {
      "name": "invert-selection",
      "label": "Invert Selection",
      "keys": "Ctrl+Shift+I"
    },
    {
      "name": "select-matching",
      "label": "Select Matching…",
      "keys": "Ctrl+Shift+M",
